    {
     "name": {
      "ja": "Mortarch of Sacrament",
      "en": "",
      "own": false,
      "fix": [],
      "note": []
     },
     "fields": {
      "timing": {
       "ja": "",
       "en": "Once Per Turn, Reaction: Opponent declared a **SPELL** ability for a unit within 18\" of this unit"
      },
      "used_by": {
       "ja": "",
       "en": ""
      },
      "declare": {
       "ja": "",
       "en": ""
      },
      "effect": {
       "ja": "",
       "en": "Roll 2D6. If the roll exceeds the casting roll for the spell, then the spell is unbound, its effect is not resolved and that **SPELL** ability cannot be used by enemy units until the start of your next turn."
      }
     },
     "own": false,
     "kw_ja": "",
     "kw_en": "",
     "cast": null,
     "cp": null,
     "note": []
    },
    {
     "name": {
      "ja": "Curse of Years",
      "en": "",
      "own": false,
      "fix": [],
      "note": []
     },
     "fields": {
      "timing": {
       "ja": "",
       "en": "Your Hero Phase"
      },
      "used_by": {
       "ja": "",
       "en": ""
      },
      "declare": {
       "ja": "",
       "en": "Pick a visible enemy unit within 12\" of this unit to be the target, then make a casting roll of 2D6."
      },
      "effect": {
       "ja": "",
       "en": "Roll 10 dice. For each 6:\n\n• Give the target 1 **necrotic withering** point.\n• Roll an extra dice.\n\nFor each 5+ on those extra dice, repeat the above bullet points, Then, do the same for each 4+ and then each 3+. Finally, for each 2+, give the target 1 **necrotic withering** point (do not roll any extra dice).\n\nAfter a roll, if the target has 8 or more **necrotic withering** points, it is automatically destroyed. Otherwise, after the last roll, inflict an amount of mortal damage on the target equal to the number of **necrotic withering** points it has. Then, those **necrotic withering** points are lost."
      }
     },
     "own": false,
     "kw_ja": "",
     "kw_en": "Spell",
     "cast": 7,
     "cp": null,
     "note": []
    },
    {
     "name": {
      "ja": "The Doom of Traitors",
      "en": "",
      "own": false,
      "fix": [],
      "note": []
     },
     "fields": {
      "timing": {
       "ja": "",
       "en": "Once Per Turn (Army), Any Combat Phase"
      },
      "used_by": {
       "ja": "",
       "en": ""
      },
      "declare": {
       "ja": "",
       "en": "If this unit charged this turn, pick an enemy unit in combat with it to be the target."
      },
      "effect": {
       "ja": "",
       "en": "Roll a D3. Add 1 to the roll if the target is a **WIZARD** or **PRIEST.** On a 2+, add an amount equal to the roll to the Attacks characteristic of this unit's **Razarak's Ebon Claws** for the rest of the phase, but while this unit is in combat with the target, all attacks made with that weapon this phase must target that enemy unit.\n\n**Designer's Note:** *If the target is a* **WIZARD** *or* **PRIEST,** *this ability cannot fail; however, you still need to roll to determine the number of extra attacks it generates.*"
      }
     },
     "own": false,
     "kw_ja": "",
     "kw_en": "Rampage",
     "cast": null,
     "cp": null,
     "note": []
    },
