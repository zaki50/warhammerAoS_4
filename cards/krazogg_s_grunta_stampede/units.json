    {
     "name": {
      "ja": "I'm Off!",
      "en": "",
      "own": false,
      "fix": [],
      "note": []
     },
     "fields": {
      "timing": {
       "ja": "",
       "en": "Your Movement Phase"
      },
      "used_by": {
       "ja": "",
       "en": ""
      },
      "declare": {
       "ja": "",
       "en": ""
      },
      "effect": {
       "ja": "",
       "en": "If this terrain feature has a Shouty Boss that was not placed on it this turn, set up the Shouty Boss on the battlefield wholly within 6\" of this terrain feature and not in combat. That unit is no longer a Shouty Boss."
      }
     },
     "own": false,
     "kw_ja": "",
     "kw_en": "",
     "cast": null,
     "cp": null,
     "note": []
    },
    {
     "name": {
      "ja": "Man Da Tower!",
      "en": "",
      "own": false,
      "fix": [],
      "note": []
     },
     "fields": {
      "timing": {
       "ja": "",
       "en": "Passive"
      },
      "used_by": {
       "ja": "",
       "en": ""
      },
      "declare": {
       "ja": "",
       "en": ""
      },
      "effect": {
       "ja": "",
       "en": "While this terrain feature has a Shouty Boss:\n\n• The Shouty Boss cannot use **MOVE** abilities.\n\n• Instead of measuring range or visibility to and from the Shouty Boss, measure to and from this terrain feature instead.\n\n• All attacks that would target the Shouty Boss target this terrain feature instead.\n\n• If this terrain feature is destroyed, before removing it from the battlefield, inflict D3 mortal damage on the Shouty Boss. Then, set up the Shouty Boss on the battlefield within 3\" of this terrain feature and not in combat.That unit is no longer the Shouty Boss. If it is not possible to set up the Shouty Boss, it is slain."
      }
     },
     "own": false,
     "kw_ja": "",
     "kw_en": "",
     "cast": null,
     "cp": null,
     "note": []
    },
    {
     "name": {
      "ja": "Aggressively Bossy",
      "en": "",
      "own": false,
      "fix": [],
      "note": []
     },
     "fields": {
      "timing": {
       "ja": "",
       "en": "Once Per Turn, Your Hero Phase"
      },
      "used_by": {
       "ja": "",
       "en": ""
      },
      "declare": {
       "ja": "",
       "en": "Pick a visible enemy unit within 18\" of this terrain feature to be the target."
      },
      "effect": {
       "ja": "",
       "en": "Roll a dice. Add 1 to the roll if this terrain feature has a Shouty Boss. On a 4+, pick 1 of the following effects to apply to the target until the start of your next turn:\n\n***Dat’s Ours, Ya Git!:*** Subtract 3 from the target’s control score.\n\n***Zog Off Wiv Ya Magic!:*** Subtract 1 from casting rolls and/or chanting rolls for the target.\n\n***Oi! Hold It!:*** Subtract 1 from the number of dice rolled when making charge rolls for the target, to a minimum of 1."
      }
     },
     "own": false,
     "kw_ja": "",
     "kw_en": "",
     "cast": null,
     "cp": null,
     "note": []
    },
    {
     "name": {
      "ja": "Up We Go!",
      "en": "",
      "own": false,
      "fix": [],
      "note": []
     },
     "fields": {
      "timing": {
       "ja": "",
       "en": "**Your Hero Phase**"
      },
      "used_by": {
       "ja": "",
       "en": ""
      },
      "declare": {
       "ja": "",
       "en": "If this terrain feature does not have a Shouty Boss, pick a friendly **IRONJAWZ INFANTRY HERO** that is not in combat and is within 3\" of it to be the target."
      },
      "effect": {
       "ja": "",
       "en": "Place the target on this terrain feature. The target is now a Shouty Boss (see ‘Man da Tower!’)."
      }
     },
     "own": false,
     "kw_ja": "",
     "kw_en": "",
     "cast": null,
     "cp": null,
     "note": []
    }
